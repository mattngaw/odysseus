+            assert_eq!(working, before.apply(mv));
+            assert_eq!(working.zobrist_key(), working.recompute_zobrist_key());
+            working.unmake(mv, undo);
+            assert_eq!(working, before);
+            assert_eq!(working.to_fen(), fen);
+            assert_eq!(working.zobrist_key(), working.recompute_zobrist_key());
