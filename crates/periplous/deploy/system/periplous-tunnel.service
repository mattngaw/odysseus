# Managed by crates/periplous/deploy/system/install-system.sh
[Unit]
Description=Odysseus optional public Cloudflare Quick Tunnel
BindsTo=periplous-prod.socket
Wants=periplous-prod.service
After=periplous-prod.socket periplous-prod.service

[Service]
Type=exec
DynamicUser=yes
ExecStart=/usr/bin/cloudflared tunnel --config /etc/periplous/quick-tunnel.yml --no-autoupdate --management-diagnostics=false --metrics 127.0.0.1:0 --url http://127.0.0.1:8765 --http-host-header localhost
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=256M
MemorySwapMax=0
TasksMax=64
CPUQuota=50%
LimitNOFILE=256

# No [Install]: never publish automatically at boot.
